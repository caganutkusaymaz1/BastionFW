# BastionFW starts in dry-run mode and never changes the host firewall by default.
ED_BT_ADE_DRY_RUN=true
ED_BT_ADE_LOG_LEVEL=INFO

# Host ports exposed by the Compose deployment.
BASTIONFW_DASHBOARD_PORT=8080
BASTIONFW_METRICS_PORT=9109

# Host directory containing logs to monitor. It is mounted read-only.
BASTIONFW_LOG_ROOT=/var/log

# Optional external integrations. Keep credentials out of this file.
# ED_BT_ADE_ABUSEIPDB_KEY=
# CORS_ALLOWED_ORIGINS=http://localhost:5173
