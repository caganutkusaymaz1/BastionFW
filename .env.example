[TEMPLATE]
# BastionFW starts in dry-run mode and never changes the host firewall by default.
ED_BT_ADE_DRY_RUN=true
ED_BT_ADE_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Dashboard API authentication (Faz 0.1)
# ---------------------------------------------------------------------------
# Every dashboard route (/, /api/status, /api/metrics, /api/bans) requires
# `Authorization: Bearer <token>`. Browsers can bootstrap an HttpOnly cookie by
# opening /?token=<token> once. Generate a strong value, never commit it:
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Fail-safe: when this variable is EMPTY the dashboard binds to 127.0.0.1 only
# even if 0.0.0.0 is requested, so an unauthenticated dashboard is never
# exposed on the network. Set it before publishing port 8080.
ED_BT_ADE_DASHBOARD_TOKEN=

# Host ports exposed by the Compose deployment.
BASTIONFW_DASHBOARD_PORT=8080
BASTIONFW_METRICS_PORT=9109

# Host directory containing logs to monitor. It is mounted read-only.
BASTIONFW_LOG_ROOT=/var/log

# ---------------------------------------------------------------------------
# Hybrid WAF (Coraza + OWASP CRS, Faz 1/2)
# ---------------------------------------------------------------------------
# Mode of the Coraza engine. `detect` is the safe default (audit-only, CRS
# actions are suppressed). `block` is an explicit opt-in; switch only after
# observing detect-mode metrics in staging. The BastionFW container reads
# ED_BT_ADE_WAF_MODE and the waf container reads WAF_MODE - keep them equal.
ED_BT_ADE_WAF_ENABLED=false
ED_BT_ADE_WAF_MODE=detect
WAF_MODE=detect

# Upstream application the WAF protects (reverse-proxy target). Point this at
# your real application, e.g. http://app:3000. The default below targets the
# bundled dashboard so the stack works end-to-end out of the box.
UPSTREAM_URL=http://bastionfw:8080

# Host port for the WAF ingress (client traffic enters here).
WAF_PORT=80

# Optional external integrations. Keep credentials out of this file.
# ED_BT_ADE_ABUSEIPDB_KEY=
# CORS_ALLOWED_ORIGINS=http://localhost:5173
