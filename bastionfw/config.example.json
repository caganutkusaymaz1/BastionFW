{
  "log_sources": [
    {
      "name": "auth",
      "path": "/var/log/auth.log",
      "encoding": "utf-8",
      "poll_interval": 0.25
    },
    {
      "name": "web",
      "path": "/var/log/nginx/access.log",
      "encoding": "utf-8",
      "poll_interval": 0.25
    }
  ],
  "queue_size": 50000,
  "metrics_host": "127.0.0.1",
  "metrics_port": 9109,
  "log_level": "INFO",
  "log_file": "state/bastionfw.log",
  "trusted_proxies": [],
  "firewall": {
    "enabled": false,
    "backend": "dry-run",
    "state_db": "state/firewall.sqlite3",
    "ban_seconds": 86400,
    "whitelist": []
  },
  "threat_intel": {
    "enabled": false,
    "cache_db": "state/threat-intel.sqlite3",
    "cache_ttl_seconds": 3600,
    "requests_per_second": 2,
    "circuit_failure_threshold": 5,
    "circuit_reset_seconds": 60,
    "abuseipdb_url": ""
  },
  "detection": {
    "ssh_failures": 8,
    "ssh_window_seconds": 60,
    "web_score_threshold": 2,
    "session_ttl_seconds": 3600
  },
  "alerting": {
    "webhooks": {
      "high": [],
      "critical": []
    },
    "batch_size": 20,
    "flush_interval_seconds": 1,
    "requests_per_second": 5
  }
}
