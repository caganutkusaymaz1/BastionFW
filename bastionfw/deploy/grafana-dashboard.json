{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Logs processed / s",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 12, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(sentinel_logs_processed_total[$__rate_interval])",
          "legendFormat": "processed"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Threats detected / s by rule",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 12, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(sentinel_threats_detected_total[$__rate_interval])",
          "legendFormat": "{{rule}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "IPs blocked (total)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        { "refId": "A", "expr": "sentinel_ips_blocked_total", "legendFormat": "blocked" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Pipeline errors / s",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 12, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(sentinel_pipeline_errors_total[$__rate_interval])",
          "legendFormat": "errors"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pipeline latency",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 12, "lineWidth": 2 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sentinel_pipeline_latency_seconds",
          "legendFormat": "latency"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["bastionfw", "security"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "BastionFW — Operations",
  "uid": "bastionfw-ops",
  "version": 1
}
